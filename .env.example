# Frontend Environment Variables
# Copy this file to .env and fill in your values

# Reown (WalletConnect) project ID (https://cloud.reown.com). Public by design;
# restrict it to the app's domains in the Reown dashboard.
NEXT_PUBLIC_PROJECT_ID=your_reown_project_id_here

# Arbitrum Sepolia RPC for the browser (wagmi transport, bridge providers).
# Ships in the client bundle: use a key restricted by domain allowlist to
# wattswap.vercel.app and wattswap.novaims.unl.pt, never one shared with a server.
# Unset: falls back to the public https://sepolia-rollup.arbitrum.io/rpc (also fine for local dev).
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/YOUR_DOMAIN_RESTRICTED_KEY

# Server-side only (no NEXT_PUBLIC_ prefix). Used by /api/faucet.
# Arbitrum Sepolia RPC for the faucet. Must NOT be domain-restricted (server requests
# send no Origin header). Optional; unset falls back to the public RPC.
ARBITRUM_SEPOLIA_RPC_URL=
FAUCET_PASSWORD=your_faucet_password_here
FAUCET_PRIVATE_KEY=your_faucet_wallet_private_key_here
